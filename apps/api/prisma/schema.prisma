generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  merge
  split
  remove_pages
  extract_pages
  organize_pdf
  sign
  compress
  protect
  unlock
  jpg_to_pdf
  pdf_to_word
  pdf_to_jpg
  pdf_to_powerpoint
  pdf_to_excel
  word_to_pdf
  excel_to_pdf
  powerpoint_to_pdf
  edit
  signature_request
}

enum TaskStatus {
  queued
  processing
  completed
  failed
}

enum SignatureRequestStatus {
  pending
  completed
  expired
  cancelled
}

enum SignatureEnvelopeStatus {
  sent
  in_progress
  finalizing
  finalization_failed
  completed
  expired
  revoked
}

enum SignatureEnvelopeRouting {
  sequential
  parallel
}

enum SignatureRecipientStatus {
  waiting
  notified
  viewed
  completed
  revoked
}

enum SignatureFieldType {
  signature
  initials
  name
  date
  checkbox
  text
}

enum SignatureEnvelopeEventType {
  created
  notification_sent
  viewed
  reminded
  completed
  finalization_failed
  reassigned
  revoked
  expired
  finalized
}

model FileObject {
  id         String   @id @default(cuid())
  objectKey  String   @unique
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  createdAt  DateTime @default(now())
  expiresAt  DateTime?
  ownerId    String?
  owner      User?    @relation("fileOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasksAsInput Task[]             @relation("taskInputFile")
  tasksAsOutput Task[]            @relation("taskOutputFile")
  signatureRequests SignatureRequest[]
  signatureEnvelopesAsSource SignatureEnvelope[] @relation("signatureEnvelopeSource")
  signatureEnvelopesAsFinal SignatureEnvelope[]  @relation("signatureEnvelopeFinal")

  @@index([ownerId, createdAt])
}

model Task {
  id            String     @id @default(cuid())
  type          TaskType
  status        TaskStatus @default(queued)
  progressPercent Int      @default(0)
  progressMessage String?
  payload       Json
  errorMessage  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  inputFileId   String?
  outputFileId  String?
  ownerId       String?
  inputFile     FileObject? @relation("taskInputFile", fields: [inputFileId], references: [id])
  outputFile    FileObject? @relation("taskOutputFile", fields: [outputFileId], references: [id])
  owner         User?       @relation("taskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

model SignatureRequest {
  id             String                  @id @default(cuid())
  token          String                  @unique
  status         SignatureRequestStatus  @default(pending)
  requesterEmail String
  signerEmail    String
  message        String?
  payload        Json?
  expiresAt      DateTime
  signedAt       DateTime?
  createdAt      DateTime                @default(now())

  fileId         String
  signedTaskId   String?
  ownerId        String?
  file           FileObject              @relation(fields: [fileId], references: [id])
  owner          User?                   @relation("signatureRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

model SignatureEnvelope {
  id             String                   @id @default(cuid())
  title          String?
  requesterEmail String
  message        String?
  outputName     String
  status         SignatureEnvelopeStatus  @default(sent)
  routing        SignatureEnvelopeRouting @default(sequential)
  expiresAt      DateTime
  immutableAt    DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  sourceFileId   String
  finalFileId    String?
  finalTaskId    String?
  ownerId        String?
  sourceFile     FileObject               @relation("signatureEnvelopeSource", fields: [sourceFileId], references: [id])
  finalFile      FileObject?              @relation("signatureEnvelopeFinal", fields: [finalFileId], references: [id])
  owner          User?                    @relation("signatureEnvelopeOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  recipients     SignatureEnvelopeRecipient[]
  fields         SignatureEnvelopeField[]
  fieldValues    SignatureEnvelopeFieldValue[]
  events         SignatureEnvelopeEvent[]

  @@index([status])
  @@index([expiresAt])
  @@index([ownerId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          UserSession[]
  passwordResetTokens PasswordResetToken[]
  files             FileObject[]        @relation("fileOwner")
  tasks             Task[]              @relation("taskOwner")
  signatureRequests SignatureRequest[]  @relation("signatureRequestOwner")
  signatureEnvelopes SignatureEnvelope[] @relation("signatureEnvelopeOwner")
}

model UserSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SignatureEnvelopeRecipient {
  id             String                  @id @default(cuid())
  token          String                  @unique
  name           String?
  email          String
  role           String?
  routingOrder   Int
  status         SignatureRecipientStatus @default(waiting)
  lastViewedAt   DateTime?
  notifiedAt     DateTime?
  remindedAt     DateTime?
  reminderCount  Int                     @default(0)
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  envelopeId     String
  envelope       SignatureEnvelope       @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  fields         SignatureEnvelopeField[]
  fieldValues    SignatureEnvelopeFieldValue[]
  events         SignatureEnvelopeEvent[]

  @@index([envelopeId, routingOrder])
  @@index([envelopeId, status])
}

model SignatureEnvelopeField {
  id             String             @id @default(cuid())
  type           SignatureFieldType
  label          String?
  placeholder    String?
  required       Boolean            @default(true)
  page           Int
  x              Float
  y              Float
  width          Float
  height         Float
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  envelopeId     String
  recipientId    String
  envelope       SignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient      SignatureEnvelopeRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  value          SignatureEnvelopeFieldValue?

  @@index([envelopeId, page])
  @@index([recipientId])
}

model SignatureEnvelopeFieldValue {
  id             String             @id @default(cuid())
  valueJson      Json
  completedAt    DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  envelopeId     String
  fieldId        String             @unique
  recipientId    String
  envelope       SignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  field          SignatureEnvelopeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recipient      SignatureEnvelopeRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([envelopeId])
  @@index([recipientId])
}

model SignatureEnvelopeEvent {
  id             String                   @id @default(cuid())
  type           SignatureEnvelopeEventType
  actorEmail     String?
  description    String
  metadata       Json?
  createdAt      DateTime                 @default(now())

  envelopeId     String
  recipientId    String?
  envelope       SignatureEnvelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient      SignatureEnvelopeRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([envelopeId, createdAt])
  @@index([recipientId])
}
