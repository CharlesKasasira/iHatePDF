generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  merge
  split
  remove_pages
  extract_pages
  organize_pdf
  sign
  compress
  protect
  unlock
  jpg_to_pdf
  pdf_to_word
  pdf_to_jpg
  pdf_to_powerpoint
  pdf_to_excel
  word_to_pdf
  excel_to_pdf
  powerpoint_to_pdf
  edit
  image_tool
  signature_request
}

enum TaskStatus {
  queued
  processing
  completed
  failed
}

enum SignatureRequestStatus {
  pending
  completed
  expired
  cancelled
}

enum SignatureEnvelopeStatus {
  sent
  in_progress
  finalizing
  finalization_failed
  completed
  expired
  revoked
}

enum SignatureEnvelopeRouting {
  sequential
  parallel
}

enum SignatureRecipientStatus {
  waiting
  notified
  viewed
  completed
  revoked
}

enum SignatureFieldType {
  signature
  initials
  name
  date
  checkbox
  text
}

enum SignatureEnvelopeEventType {
  created
  notification_sent
  otp_requested
  otp_verified
  otp_failed
  passcode_verified
  passcode_failed
  viewed
  reminded
  completed
  finalization_failed
  completion_email_sent
  completion_email_failed
  reassigned
  revoked
  expired
  finalized
}

enum UserSecurityEventType {
  login_success
  login_failed
  account_auto_locked
  account_locked
  account_unlocked
  sessions_revoked
}

model FileObject {
  id         String   @id @default(cuid())
  objectKey  String   @unique
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  createdAt  DateTime @default(now())
  expiresAt  DateTime?
  ownerId    String?
  owner      User?    @relation("fileOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasksAsInput Task[]             @relation("taskInputFile")
  tasksAsOutput Task[]            @relation("taskOutputFile")
  shares FileShare[]
  signatureRequests SignatureRequest[]
  signatureEnvelopesAsSource SignatureEnvelope[] @relation("signatureEnvelopeSource")
  signatureEnvelopesAsFinal SignatureEnvelope[]  @relation("signatureEnvelopeFinal")

  @@index([ownerId, createdAt])
}

model FileDeletionReceipt {
  id             String   @id @default(cuid())
  fileId         String?
  objectKey      String
  fileName       String
  mimeType       String
  sizeBytes      BigInt
  ownerId        String?
  ownerEmail     String?
  reason         String
  storageDeleted Boolean  @default(false)
  storageError   String?
  fileCreatedAt  DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime @default(now())

  @@index([deletedAt])
  @@index([ownerId, deletedAt])
}

model FileShare {
  id             String    @id @default(cuid())
  token          String    @unique
  recipientEmail String?
  message        String?
  expiresAt      DateTime
  lastAccessedAt DateTime?
  downloadCount  Int       @default(0)
  createdAt      DateTime  @default(now())

  fileId         String
  createdById    String?
  file           FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy      User?      @relation("fileShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments       FileShareComment[]

  @@index([fileId, createdAt])
  @@index([createdById, createdAt])
  @@index([expiresAt])
}

model FileShareComment {
  id          String   @id @default(cuid())
  authorName  String?
  authorEmail String?
  pageNumber  Int
  body        String
  x           Float?
  y           Float?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  shareId     String
  share       FileShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, createdAt])
  @@index([shareId, pageNumber])
}

model Task {
  id            String     @id @default(cuid())
  type          TaskType
  status        TaskStatus @default(queued)
  progressPercent Int      @default(0)
  progressMessage String?
  retryCount    Int        @default(0)
  lastRetriedAt DateTime?
  payload       Json
  errorMessage  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  inputFileId   String?
  outputFileId  String?
  ownerId       String?
  inputFile     FileObject? @relation("taskInputFile", fields: [inputFileId], references: [id])
  outputFile    FileObject? @relation("taskOutputFile", fields: [outputFileId], references: [id])
  owner         User?       @relation("taskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

model SignatureRequest {
  id             String                  @id @default(cuid())
  token          String                  @unique
  status         SignatureRequestStatus  @default(pending)
  requesterEmail String
  signerEmail    String
  message        String?
  payload        Json?
  expiresAt      DateTime
  signedAt       DateTime?
  createdAt      DateTime                @default(now())

  fileId         String
  signedTaskId   String?
  ownerId        String?
  file           FileObject              @relation(fields: [fileId], references: [id])
  owner          User?                   @relation("signatureRequestOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
}

model SignatureEnvelope {
  id             String                   @id @default(cuid())
  title          String?
  requesterEmail String
  message        String?
  outputName     String
  status         SignatureEnvelopeStatus  @default(sent)
  routing        SignatureEnvelopeRouting @default(sequential)
  expiresAt      DateTime
  immutableAt    DateTime
  startedAt      DateTime?
  completedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  sourceFileId   String
  finalFileId    String?
  finalTaskId    String?
  ownerId        String?
  sourceFile     FileObject               @relation("signatureEnvelopeSource", fields: [sourceFileId], references: [id])
  finalFile      FileObject?              @relation("signatureEnvelopeFinal", fields: [finalFileId], references: [id])
  owner          User?                    @relation("signatureEnvelopeOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  recipients     SignatureEnvelopeRecipient[]
  fields         SignatureEnvelopeField[]
  fieldValues    SignatureEnvelopeFieldValue[]
  events         SignatureEnvelopeEvent[]

  @@index([status])
  @@index([expiresAt])
  @@index([ownerId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  isAdmin      Boolean  @default(false)
  suspendedAt  DateTime?
  lockedAt     DateTime?
  lockReason   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          UserSession[]
  securityEvents    UserSecurityEvent[]
  passwordResetTokens PasswordResetToken[]
  files             FileObject[]        @relation("fileOwner")
  fileShares        FileShare[]         @relation("fileShareCreator")
  tasks             Task[]              @relation("taskOwner")
  signatureRequests SignatureRequest[]  @relation("signatureRequestOwner")
  signatureEnvelopes SignatureEnvelope[] @relation("signatureEnvelopeOwner")
  signatureEnvelopeTemplates SignatureEnvelopeTemplate[]
  apiKeys           ApiKey[]
  apiUsageEvents    ApiUsageEvent[]
  webhookEndpoints  WebhookEndpoint[]
}

model UserSecurityEvent {
  id          String                @id @default(cuid())
  type        UserSecurityEventType
  email       String?
  actorEmail  String?
  ipAddress   String?
  userAgent   String?
  description String
  metadata    Json?
  createdAt   DateTime              @default(now())

  userId      String?
  user        User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([type, createdAt])
}

model UserSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyPrefix   String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  rateLimitedAt DateTime?
  rateLimitReason String?
  createdAt   DateTime  @default(now())

  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  usageEvents ApiUsageEvent[]

  @@index([ownerId, createdAt])
  @@index([keyPrefix])
}

model ApiUsageEvent {
  id          String    @id @default(cuid())
  method      String
  route       String
  statusCode  Int?
  taskId      String?
  fileId      String?
  createdAt   DateTime  @default(now())

  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  apiKeyId    String?
  apiKey      ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([route, createdAt])
}

model WebhookEndpoint {
  id             String            @id @default(cuid())
  url            String
  description    String?
  events         Json
  signingSecret  String
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  ownerId        String
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([ownerId, createdAt])
  @@index([ownerId, active])
}

model WebhookDelivery {
  id             String          @id @default(cuid())
  eventType      String
  payload        Json
  status         String
  responseStatus Int?
  responseBody   String?
  errorMessage   String?
  attemptCount   Int             @default(0)
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())

  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([eventType, createdAt])
  @@index([status, createdAt])
}

model SignatureEnvelopeRecipient {
  id             String                  @id @default(cuid())
  token          String                  @unique
  name           String?
  email          String
  role           String?
  routingOrder   Int
  status         SignatureRecipientStatus @default(waiting)
  lastViewedAt   DateTime?
  notifiedAt     DateTime?
  remindedAt     DateTime?
  reminderCount  Int                     @default(0)
  otpHash        String?
  otpExpiresAt   DateTime?
  otpVerifiedAt  DateTime?
  otpAttemptCount Int                    @default(0)
  passcodeHash   String?
  passcodeVerifiedAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  envelopeId     String
  envelope       SignatureEnvelope       @relation(fields: [envelopeId], references: [id], onDelete: Cascade)

  fields         SignatureEnvelopeField[]
  fieldValues    SignatureEnvelopeFieldValue[]
  events         SignatureEnvelopeEvent[]

  @@index([envelopeId, routingOrder])
  @@index([envelopeId, status])
}

model SignatureEnvelopeField {
  id             String             @id @default(cuid())
  type           SignatureFieldType
  label          String?
  placeholder    String?
  required       Boolean            @default(true)
  page           Int
  x              Float
  y              Float
  width          Float
  height         Float
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  envelopeId     String
  recipientId    String
  envelope       SignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient      SignatureEnvelopeRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  value          SignatureEnvelopeFieldValue?

  @@index([envelopeId, page])
  @@index([recipientId])
}

model SignatureEnvelopeFieldValue {
  id             String             @id @default(cuid())
  valueJson      Json
  completedAt    DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  envelopeId     String
  fieldId        String             @unique
  recipientId    String
  envelope       SignatureEnvelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  field          SignatureEnvelopeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recipient      SignatureEnvelopeRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([envelopeId])
  @@index([recipientId])
}

model SignatureEnvelopeEvent {
  id             String                   @id @default(cuid())
  type           SignatureEnvelopeEventType
  actorEmail     String?
  ipAddress      String?
  userAgent      String?
  description    String
  metadata       Json?
  createdAt      DateTime                 @default(now())

  envelopeId     String
  recipientId    String?
  envelope       SignatureEnvelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  recipient      SignatureEnvelopeRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([envelopeId, createdAt])
  @@index([recipientId])
}

model SignatureEnvelopeTemplate {
  id             String                   @id @default(cuid())
  name           String
  title          String?
  requesterEmail String?
  message        String?
  outputName     String
  routing        SignatureEnvelopeRouting @default(sequential)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  ownerId        String
  owner          User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recipients     SignatureEnvelopeTemplateRecipient[]
  fields         SignatureEnvelopeTemplateField[]

  @@index([ownerId, createdAt])
}

model SignatureEnvelopeTemplateRecipient {
  id             String                    @id @default(cuid())
  key            String
  name           String?
  email          String?
  role           String?
  routingOrder   Int
  createdAt      DateTime                  @default(now())

  templateId     String
  template       SignatureEnvelopeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields         SignatureEnvelopeTemplateField[]

  @@unique([templateId, key])
  @@index([templateId, routingOrder])
}

model SignatureEnvelopeTemplateField {
  id             String             @id @default(cuid())
  type           SignatureFieldType
  label          String?
  placeholder    String?
  required       Boolean            @default(true)
  page           Int
  x              Float
  y              Float
  width          Float
  height         Float
  createdAt      DateTime           @default(now())

  templateId     String
  recipientId    String
  template       SignatureEnvelopeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipient      SignatureEnvelopeTemplateRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([templateId, page])
  @@index([recipientId])
}
